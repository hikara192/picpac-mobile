# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Local environment of the mock/BFF: keys never enter the repository.
# `.env.example` is a tracked template with names only.
.env
.env.*
!.env.example

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Golden failure artefacts: `flutter_test` writes <test>_failures/ next to the
# test file on a mismatch, and a stale directory once landed in the repository.
test/render/failures/
**/failures/
