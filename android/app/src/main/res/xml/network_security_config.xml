<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds speak HTTPS only. Local mock addresses are whitelisted in
     the debug variant (android/app/src/debug/res/xml/...). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
