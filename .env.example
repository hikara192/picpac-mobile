# PicPac — имена переменных окружения.
#
# Здесь только имена: значений нет и быть не может. Ключи живут в secret
# manager или в локальном `.env`, который не коммитится (см. .gitignore).
# Шаблон не является `.env`: скопируйте в `.env` и заполните у себя.

# --- mock / BFF (сервер, не сборка приложения) -----------------------------
# AI_PROVIDER=mock | none | agent (алиасы: opencode, opencode-go, pi, pi-agent)
AI_PROVIDER=
# База OpenAI-совместимого шлюза без /chat/completions, например .../v1
AGENT_BASE_URL=
# Alias модели в шлюзе (не секрет)
AGENT_MODEL=
# Bearer-токен шлюза: secret manager, не репозиторий
AGENT_API_KEY=

# Подпись PSP-вебхуков (dev-значение по умолчанию небезопасно)
PSP_WEBHOOK_SECRET=

# Демо-контролы /v1/mock/* (1 = включены; не для production-like прогона)
MOCK_CONTROLS=
MOCK_ALLOW_ANONYMOUS=
